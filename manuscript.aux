\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of StiXpert. Solar-physics and STIX-specific knowledge, STIX software and Data Center resources, and selected SSWIDL resources for multiple instruments are indexed and made accessible to an AI client through MCP. The client uses these resources to answer knowledge questions, discover observations and methods, and support analysis code. The server provides retrieval tools; it does not execute analysis or validate scientific conclusions. }}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{4}{Overview of StiXpert. Solar-physics and STIX-specific knowledge, STIX software and Data Center resources, and selected SSWIDL resources for multiple instruments are indexed and made accessible to an AI client through MCP. The client uses these resources to answer knowledge questions, discover observations and methods, and support analysis code. The server provides retrieval tools; it does not execute analysis or validate scientific conclusions}{figure.caption.1}{}}
\newlabel{fig:architecture@cref}{{[figure][1][]1}{[1][3][]4}{}{}{}}
